# Copiar a /etc/traccar-backup-pull.env (root:root, 600)
# Topic de ntfy.sh (obligatorio; se avisa SOLO en fallo)
NTFY_TOPIC=
# Días de retención local en el Vostro
RETENTION_DAYS=60
# Destino local del pull (por defecto /home/daniel/backups/traccar-vps)
#LOCAL_DIR=
# Antigüedad máxima del volcado más reciente, en horas (por defecto 25)
#MAX_AGE_HOURS=25
# URL del monitor Push de Uptime Kuma (opcional; vacía = omitir el latido):
#   http://localhost:3001/api/push/<token>
#KUMA_PUSH_URL=
# Origen remoto visto por rrsync (la clave está restringida a ese directorio)
REMOTE_SRC=danfercf@danfercf.online:./
# Clave SSH dedicada (por defecto /home/daniel/.ssh/traccar-backup)
#SSH_KEY=
