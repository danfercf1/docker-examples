TRACCAR_DB_PASSWORD=

# -- gateway ntfy: Traccar -> event.forward -> gateway -> ntfy.sh -----------

# Token compartido Traccar <-> gateway ntfy (obligatorio):
#   openssl rand -hex 24
TRACCAR_NTFY_GATEWAY_TOKEN=

# Tema de RESPALDO (antes NTFY_TOPIC_ALERTS): recibe los avisos de
# dispositivos sin ningún usuario con ntfyTopic configurado, y los avisos
# técnicos del propio gateway (p.ej. token de la API de Traccar caducado).
# Migración: si ya usabas NTFY_TOPIC_ALERTS, pon aquí el mismo valor y
# además configúralo como atributo ntfyTopic de tu propio usuario en
# Traccar (ver docs/MANUAL-ADMIN.md) para seguir recibiendo todo como antes.
NTFY_TOPIC_ADMIN=

# Cuenta de servicio de solo lectura para consultar usuarios/dispositivos
# (ver docs/MANUAL-ADMIN.md para crearla). Token generado con caducidad
# larga (ej. 1 año) vía POST /api/session/token.
TRACCAR_API_TOKEN=
# Email o login EXACTO de la cuenta de servicio: se excluye siempre como
# destinataria de avisos.
TRACCAR_SERVICE_USER=

# Opcionales (valores por defecto entre paréntesis):
# TRACCAR_URL (http://traccar:8082)
# TRACCAR_CACHE_SECONDS (300)
# SENT_LOG_DAYS (90)
# LOG_LEVEL (INFO)
# COOLDOWN_MINUTES (10)
# OFFLINE_SUSTAINED_MINUTES (15)
# NTFY_URL (https://ntfy.sh)
